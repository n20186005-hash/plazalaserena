---
import '../styles/global.css';
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const canonical = siteUrl ? `${siteUrl}${Astro.url.pathname}` : Astro.url.pathname;
const hero = '/images/faro-monumental.jpg';
const attractions = [
  { title:'Faro Monumental', text:'El ícono de la costanera: una torre de hormigón frente al Pacífico, perfecta para caminar cuando baja la luz.', image:'/images/faro-monumental.jpg', alt:'Faro Monumental de La Serena junto a la playa' },
  { title:'Centro histórico', text:'Calles de piedra, iglesias y fachadas neocoloniales alrededor de la Plaza de Armas, el corazón antiguo de la ciudad.', image:'/images/catedral-la-serena.jpg', alt:'Catedral de La Serena en el centro histórico' },
  { title:'Cielo del Elqui', text:'A poca distancia, el valle abre una de las grandes puertas astronómicas de Chile: noches secas, oscuras y nítidas.', image:'/images/playa-la-serena.jpg', alt:'Costa y playa de La Serena' }
];
const faqs = [
  ['¿Cuál es la mejor época para visitar La Serena?', 'El verano ofrece más días de playa; otoño y primavera suelen ser agradables para combinar costa, centro histórico y excursiones al valle.'],
  ['¿Cuánto tiempo conviene quedarse?', 'Dos días permiten conocer el Faro, la Avenida del Mar y el centro. Suma una noche extra si quieres visitar el Valle del Elqui u observar estrellas.'],
  ['¿La entrada al Faro Monumental tiene costo?', 'El acceso exterior y la explanada son gratuitos. La apertura del interior y las visitas guiadas pueden variar: conviene verificar localmente antes de ir.'],
  ['¿Se puede llegar sin auto?', 'Sí. La Serena tiene buses interurbanos, taxis colectivos y transporte urbano; para el Valle del Elqui resulta más práctico contratar una excursión o revisar los horarios de buses.']
];
const jsonLd = {
  '@context':'https://schema.org', '@type':'TouristAttraction', name:'La Serena, Coquimbo', description:'Guía visual para descubrir las playas, el patrimonio y los cielos de La Serena.', url:siteUrl ? `${siteUrl}/` : undefined,
  address:{'@type':'PostalAddress', addressLocality:'La Serena', addressRegion:'Coquimbo', addressCountry:'CL'}, geo:{'@type':'GeoCoordinates', latitude:-29.9, longitude:-71.25}, openingHours:'Mo-Su 00:00-23:59', aggregateRating:{'@type':'AggregateRating', ratingValue:4.7, ratingCount:34136}, sameAs:['https://www.google.com/maps/search/?api=1&query=La%20Serena%2C%20Coquimbo%2C%20Chile']
};
const faqLd = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<html lang="es-CL">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <title>La Serena · Costa, historia y cielos del Elqui</title>
  <meta name="description" content="Una guía local para descubrir La Serena: Faro Monumental, centro histórico, playas, sabores y cielos estrellados." />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content="La Serena · Costa, historia y cielos del Elqui" /><meta property="og:description" content="La ciudad donde el Pacífico se encuentra con el desierto y las estrellas." /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content={siteUrl ? `${siteUrl}${hero}` : hero} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-16.svg" sizes="16x16" type="image/svg+xml" /><link rel="apple-touch-icon" href="/favicon.svg" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script><script is:inline>const w=Function('return this')();w.dataLayer=w.dataLayer||[];function gtag(){w.dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
</head>
<body>
<header class="fixed top-0 z-50 w-full border-b border-white/20 bg-[#102a43]/90 text-[#f8f3ea] backdrop-blur-md"><div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4"><a href="#inicio" class="flex items-center gap-3 text-sm font-bold tracking-[.18em] uppercase sans"><span class="grid size-9 place-items-center rounded-xl bg-[#f2c078]"><svg viewBox="0 0 32 32" class="size-7"><path d="M8 24h16M10 22V11l6-6 6 6v11M12 15h8M12 19h8" fill="none" stroke="#102a43" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>La Serena</a><nav class="hidden gap-6 text-xs font-semibold uppercase tracking-wider md:flex"><a href="#esencia" class="hover:text-[#f2c078]">Esencia</a><a href="#plan" class="hover:text-[#f2c078]">Planifica</a><a href="#mapa" class="hover:text-[#f2c078]">Mapa</a></nav></div></header>
<main id="inicio">
<section class="relative min-h-[92vh] overflow-hidden bg-[#102a43] text-[#f8f3ea]"><img src={hero} alt="Faro Monumental de La Serena frente al océano" class="absolute inset-0 size-full object-cover opacity-50" /><div class="absolute inset-0 bg-gradient-to-r from-[#102a43] via-[#102a43]/70 to-transparent"></div><div class="relative mx-auto flex min-h-[92vh] max-w-6xl items-end px-5 pb-20 pt-32"><div class="max-w-3xl"><p class="sans mb-5 text-xs font-bold uppercase tracking-[.32em] text-[#f2c078]">Región de Coquimbo · Chile</p><h1 class="max-w-3xl text-6xl leading-[.95] tracking-[-.04em] md:text-8xl">Donde el mar<br/><em class="font-normal text-[#f2c078]">enciende</em> el cielo.</h1><p class="mt-7 max-w-xl text-lg leading-relaxed text-[#e3eef2]">La Serena es una pausa luminosa entre el Pacífico y el desierto: patrimonio, arena dorada y noches que invitan a mirar hacia arriba.</p><div class="mt-9 flex flex-wrap gap-3 sans"><a href="#esencia" class="rounded-full bg-[#f2c078] px-6 py-3 text-sm font-bold text-[#102a43] hover:bg-white">Explorar la ciudad ↓</a><a href="#mapa" class="rounded-full border border-white/40 px-6 py-3 text-sm font-bold hover:border-[#f2c078] hover:text-[#f2c078]">Abrir mapa</a></div></div></div><div class="absolute bottom-6 right-6 hidden max-w-xs border-l border-[#f2c078] pl-4 text-xs leading-relaxed text-[#e3eef2] md:block sans">Fotografía: Vavillegash · CC BY-SA 3.0<br/>Faro Monumental de La Serena</div></section>
<section id="esencia" class="texture mx-auto max-w-6xl px-5 py-24"><div class="grid gap-12 md:grid-cols-[.75fr_1.25fr] md:items-end"><div><p class="sans text-xs font-bold uppercase tracking-[.28em] text-[#df7658]">La mezcla que define el lugar</p><h2 class="mt-4 text-5xl leading-none md:text-6xl">Tres paisajes.<br/><span class="text-[#df7658]">Una misma luz.</span></h2></div><p class="text-xl leading-relaxed text-[#36566d]">Fundada en 1544 y capital de la Región de Coquimbo, la ciudad se disfruta sin prisa: una mañana de patrimonio, una tarde frente al mar y una noche bajo el cielo del Elqui.</p></div><div class="mt-14 grid gap-6 md:grid-cols-3">{attractions.map((item, i)=><article class={`card lift overflow-hidden ${i===1?'md:translate-y-10':''}`}><img src={item.image} alt={item.alt} class="h-64 w-full object-cover" /><div class="p-6"><p class="sans text-xs font-bold text-[#df7658]">0{i+1}</p><h3 class="mt-2 text-2xl">{item.title}</h3><p class="mt-3 leading-relaxed text-[#36566d]">{item.text}</p></div></article>)}</div></section>
<section id="plan" class="bg-[#dce9eb] px-5 py-24"><div class="mx-auto max-w-6xl"><div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end"><div><p class="sans text-xs font-bold uppercase tracking-[.28em] text-[#df7658]">Guía práctica</p><h2 class="mt-4 text-5xl">Arma tu recorrido</h2></div><p class="max-w-md text-[#36566d]">La información cambia según temporada. Usa estas notas como brújula y confirma horarios y precios en el destino.</p></div><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3"><article class="card rounded-2xl p-7"><span class="text-3xl">✦</span><h3 class="mt-5 text-2xl">Mejor momento</h3><p class="mt-3 leading-relaxed text-[#36566d]">Atardecer en el Faro y primera hora en el centro. Para astronomía, elige una noche despejada y sin luna intensa.</p><p class="sans mt-5 text-xs font-bold uppercase tracking-wider text-[#df7658]">Sugerencia · 2–3 días</p></article><article class="card rounded-2xl p-7"><span class="text-3xl">⌁</span><h3 class="mt-5 text-2xl">Cómo llegar y moverse</h3><p class="mt-3 leading-relaxed text-[#36566d]">El aeropuerto La Florida conecta la ciudad por carretera; desde Santiago también hay buses. En la ciudad: caminata, taxi colectivo y buses locales.</p><p class="sans mt-5 text-xs font-bold uppercase tracking-wider text-[#df7658]">Costa · Centro · Valle</p></article><article class="card rounded-2xl p-7"><span class="text-3xl">◌</span><h3 class="mt-5 text-2xl">Entradas y costos</h3><p class="mt-3 leading-relaxed text-[#36566d]">La playa, el paseo costero y la vista exterior del Faro son gratuitos. Museos, tours astronómicos y observatorios tienen tarifas propias.</p><p class="sans mt-5 text-xs font-bold uppercase tracking-wider text-[#df7658]">Confirma antes de reservar</p></article><article class="card rounded-2xl p-7"><span class="text-3xl">⌂</span><h3 class="mt-5 text-2xl">Dónde estacionar</h3><p class="mt-3 leading-relaxed text-[#36566d]">En la Avenida del Mar hay estacionamientos y espacios públicos señalizados. En el centro, prioriza estacionamientos formales y evita dejar objetos visibles.</p></article><article class="card rounded-2xl p-7"><span class="text-3xl">✺</span><h3 class="mt-5 text-2xl">Sabores del entorno</h3><p class="mt-3 leading-relaxed text-[#36566d]">Busca pescados y mariscos, empanadas de mar, papayas de la región y pisco del valle. En Caleta San Pedro y Peñuelas hay cocina marina.</p></article><article class="card rounded-2xl p-7"><span class="text-3xl">↗</span><h3 class="mt-5 text-2xl">Cerca de aquí</h3><p class="mt-3 leading-relaxed text-[#36566d]">Coquimbo y su Cruz del Tercer Milenio quedan al sur; Valle del Elqui, Vicuña y Paihuano abren la ruta de los cielos y el pisco.</p></article></div></div></section>
<section id="mapa" class="bg-[#102a43] px-5 py-24 text-[#f8f3ea]"><div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><p class="sans text-xs font-bold uppercase tracking-[.28em] text-[#f2c078]">Ubicación</p><h2 class="mt-4 text-5xl">La ciudad,<br/><em class="font-normal text-[#f2c078]">a escala humana.</em></h2><p class="mt-5 max-w-md leading-relaxed text-[#c6d8de]">La Serena, Región de Coquimbo, Chile · 29.900° S, 71.250° O</p><a class="sans mt-8 inline-flex rounded-full border border-[#f2c078] px-5 py-3 text-sm font-bold text-[#f2c078] hover:bg-[#f2c078] hover:text-[#102a43]" href="https://www.google.com/maps/search/?api=1&query=La%20Serena%2C%20Coquimbo%2C%20Chile" target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a></div><div class="overflow-hidden rounded-3xl border-8 border-white/10 bg-white"><iframe title="Mapa de La Serena, Chile" src="https://www.google.com/maps?q=La+Serena%2C+Coquimbo%2C+Chile&output=embed&hl=es&region=CL" width="100%" height="420" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div></section>
<section class="texture mx-auto max-w-4xl px-5 py-24"><div class="text-center"><p class="sans text-xs font-bold uppercase tracking-[.28em] text-[#df7658]">Preguntas frecuentes</p><h2 class="mt-4 text-5xl">Antes de partir</h2></div><div class="mt-12 divide-y divide-[#102a43]/15">{faqs.map(([q,a])=><details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl font-bold"><span>{q}</span><span class="text-2xl text-[#df7658] transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl leading-relaxed text-[#36566d]">{a}</p></details>)}</div></section>
</main>
<footer class="bg-[#0b1f31] px-5 py-12 text-[#c6d8de]"><div class="mx-auto flex max-w-6xl flex-col justify-between gap-7 md:flex-row md:items-end"><div><div class="flex items-center gap-3 text-lg font-bold text-[#f8f3ea]"><span class="grid size-9 place-items-center rounded-xl bg-[#f2c078] text-[#102a43]">✦</span>La Serena</div><p class="mt-4 max-w-md text-sm leading-relaxed">Una guía independiente para mirar la ciudad con otros ojos.</p></div><p class="max-w-sm text-xs leading-relaxed md:text-right">Este sitio no es oficial ni está afiliado a la Municipalidad de La Serena, operadores turísticos o Google Maps. Verifica horarios, tarifas y condiciones directamente.</p></div></footer>
</body></html>
